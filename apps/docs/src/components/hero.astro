---
// biome-ignore lint/correctness/noUnusedImports: used in Astro template
import { Image } from "astro:assets";
// biome-ignore lint/correctness/noUnusedImports: used in Astro template
import logo from "../assets/logo.png";
// biome-ignore lint/correctness/noUnusedImports: used in Astro template
import HeroDemoCard from "./hero-demo-card.astro";

const { data } = Astro.locals.starlightRoute.entry;
const hero = data.hero;
if (!hero) {
  return;
}

// biome-ignore lint/correctness/noUnusedVariables: used in Astro template
const wordmark = "IntentForm".split("");
---

<div class="hero-wrapper">
  <!-- Single static radial — no animated orbs -->
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="hero-grid">
    <!-- Left column: brand + copy + CTA -->
    <div class="hero-left">
      <div class="hero-brand" aria-label="IntentForm">
        <div class="hero-logo-wrap">
          <Image src={logo} alt="IntentForm logo" width={48} height={48} />
          <div class="hero-logo-ring" aria-hidden="true"></div>
        </div>
        <span class="hero-wordmark" aria-hidden="true">
          {wordmark.map((letter, i) => (
            <span
              class="hero-letter"
              style={`animation-delay: ${i * 40}ms`}
            >{letter}</span>
          ))}
        </span>
      </div>

      <p class="hero-eyebrow">Open source · React · AI-powered</p>

      {hero?.tagline && (
        <p class="hero-tagline">{hero.tagline}</p>
      )}

      {hero?.actions && hero.actions.length > 0 && (
        <div class="hero-actions">
          {hero.actions.map((action) => (
            <a
              href={action.link}
              class:list={["hero-btn", action.variant === "primary" ? "hero-btn-primary" : "hero-btn-secondary"]}
            >
              {action.text}
            </a>
          ))}
        </div>
      )}

      <div class="hero-badges">
        <a
          href="https://github.com/wraithyy/IntentForm"
          class="hero-badge"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          GitHub
        </a>
        <span class="hero-badge-sep">·</span>
        <span class="hero-badge-text">MIT license</span>
        <span class="hero-badge-sep">·</span>
        <span class="hero-badge-text">4 AI providers</span>
        <span class="hero-badge-sep">·</span>
        <span class="hero-badge-text">2 adapters</span>
      </div>
    </div>

    <!-- Right column: animated demo card -->
    <div class="hero-right">
      <HeroDemoCard />
    </div>
  </div>

  <!-- Bottom hairline separator -->
  <div class="hero-separator" aria-hidden="true"></div>
</div>

<style>
  /* ── Wrapper ── */
  .hero-wrapper {
    position: relative;
    overflow: hidden;
    margin: 0 calc(-1 * var(--sl-content-pad-x, 1rem));
    padding: 3.5rem 2rem 4rem;
    background: var(--sl-color-bg);
  }

  /* Single static radial — no animation */
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 60% at -10% -10%, color-mix(in srgb, var(--sl-color-accent) 9%, transparent) 0%, transparent 60%),
      radial-gradient(ellipse 40% 50% at 110% 80%, color-mix(in srgb, #b4befe 5%, transparent) 0%, transparent 60%);
    pointer-events: none;
  }

  /* ── 2-column grid ── */
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 3rem;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      max-width: 600px;
    }
    .hero-right {
      order: 2;
    }
    .hero-left {
      order: 1;
    }
  }

  /* ── Left: brand mark ── */
  .hero-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.5rem;
  }

  .hero-logo-wrap {
    position: relative;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    animation: logoEntrance 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .hero-logo-wrap img {
    width: 48px;
    height: 48px;
    border-radius: 11px;
    position: relative;
    z-index: 1;
    animation: logoBreathe 7s ease-in-out infinite alternate;
  }

  .hero-logo-ring {
    position: absolute;
    inset: -4px;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 30%, transparent);
    animation: ringPulse 0.7s ease-out 0.4s both;
  }

  @keyframes logoEntrance {
    from { opacity: 0; transform: scale(0.8); }
    to   { opacity: 1; transform: scale(1); }
  }

  @keyframes logoBreathe {
    from { transform: scale(1); }
    to   { transform: scale(1.025); }
  }

  @keyframes ringPulse {
    from { opacity: 0; transform: scale(0.85); }
    to   { opacity: 1; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-logo-wrap { animation: none; }
    .hero-logo-wrap img { animation: none; }
    .hero-logo-ring { animation: none; }
  }

  /* Wordmark with staggered letter entrance */
  .hero-wordmark {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: clamp(1.7rem, 3.5vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
    display: flex;
  }

  .hero-letter {
    display: inline-block;
    animation: letterIn 0.5s cubic-bezier(0.34, 1.4, 0.64, 1) both;
    opacity: 0;
  }

  @keyframes letterIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-letter { animation: none; opacity: 1; }
  }

  /* ── Eyebrow ── */
  .hero-eyebrow {
    font-family: 'Outfit', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sl-color-accent);
    margin-bottom: 1.25rem;
    animation: fadeUp 0.5s ease 0.55s both;
  }

  /* ── Tagline ── */
  .hero-tagline {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    color: var(--sl-color-gray-2);
    line-height: 1.65;
    margin: 0 0 2rem;
    max-width: 440px;
    animation: fadeUp 0.5s ease 0.75s both;
  }

  /* ── CTA buttons ── */
  .hero-actions {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
    animation: fadeUp 0.5s ease 0.85s both;
  }

  .hero-btn {
    font-family: 'Outfit', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.6rem 1.35rem;
    border-radius: 8px;
    text-decoration: none;
    transition: transform 0.12s, box-shadow 0.12s, background 0.12s;
    white-space: nowrap;
  }

  .hero-btn:hover {
    transform: translateY(-1px);
  }

  .hero-btn-primary {
    background: var(--sl-color-accent);
    color: #1e1e2e;
    box-shadow: 0 0 18px color-mix(in srgb, var(--sl-color-accent) 40%, transparent);
  }

  .hero-btn-primary:hover {
    box-shadow: 0 0 28px color-mix(in srgb, var(--sl-color-accent) 60%, transparent);
  }

  .hero-btn-secondary {
    background: color-mix(in srgb, var(--sl-color-white) 6%, transparent);
    color: var(--sl-color-gray-1);
    border: 1px solid color-mix(in srgb, var(--sl-color-white) 14%, transparent);
    backdrop-filter: blur(8px);
  }

  .hero-btn-secondary:hover {
    background: color-mix(in srgb, var(--sl-color-white) 10%, transparent);
    color: var(--sl-color-white);
  }

  /* ── Badges row ── */
  .hero-badges {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    animation: fadeUp 0.5s ease 0.95s both;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: 'Outfit', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    padding: 0.2rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-white) 12%, transparent);
    border-radius: 100px;
    background: color-mix(in srgb, var(--sl-color-white) 4%, transparent);
    transition: border-color 0.15s, color 0.15s;
  }

  .hero-badge:hover {
    border-color: color-mix(in srgb, var(--sl-color-accent) 40%, transparent);
    color: var(--sl-color-white);
  }

  .hero-badge svg {
    opacity: 0.7;
  }

  .hero-badge-sep {
    font-size: 0.7rem;
    color: var(--sl-color-gray-4);
  }

  .hero-badge-text {
    font-family: 'Outfit', sans-serif;
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }

  /* ── Right column ── */
  .hero-right {
    animation: heroRightEntrance 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
  }

  @keyframes heroRightEntrance {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-right { animation: none; }
  }

  /* ── Shared fade-up entrance ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow,
    .hero-title,
    .hero-tagline,
    .hero-actions,
    .hero-badges {
      animation: none;
    }
  }

  /* ── Bottom hairline separator ── */
  .hero-separator {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      color-mix(in srgb, var(--sl-color-accent) 20%, transparent) 30%,
      color-mix(in srgb, var(--sl-color-white) 12%, transparent) 50%,
      color-mix(in srgb, var(--sl-color-accent) 20%, transparent) 70%,
      transparent 100%
    );
  }

  /* ── Light theme ── */
  [data-theme="light"] .hero-wordmark { color: var(--sl-color-black); }
  [data-theme="light"] .hero-title { color: var(--sl-color-black); }
  [data-theme="light"] .hero-done { color: var(--sl-color-gray-2); }
  [data-theme="light"] .hero-btn-primary { color: #fff; }
  [data-theme="light"] .hero-badge {
    border-color: color-mix(in srgb, var(--sl-color-black) 12%, transparent);
    background: color-mix(in srgb, var(--sl-color-black) 4%, transparent);
    color: var(--sl-color-gray-2);
  }
  [data-theme="light"] .hero-btn-secondary {
    background: color-mix(in srgb, var(--sl-color-black) 4%, transparent);
    border-color: color-mix(in srgb, var(--sl-color-black) 12%, transparent);
    color: var(--sl-color-gray-1);
  }
</style>
